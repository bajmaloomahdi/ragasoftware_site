APP_NAME="RagaSoftware"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8) ---
# Host CLI (artisan on Windows):   DB_HOST=127.0.0.1  DB_PORT=${DB_FORWARD_PORT}
# Inside Docker "app" container:   DB_HOST=mysql      DB_PORT=3306   (set in docker-compose.yml)
# Shared hosting:                  use the host's MySQL credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ragasoftware
DB_USERNAME=raga
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# --- Docker forwarded ports (host side) ---
APP_FORWARD_PORT=8080
DB_FORWARD_PORT=3306
VITE_PORT=5173
ADMINER_FORWARD_PORT=8081

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@ragasoftware.ir"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CMS / site ---
SEED_ADMIN_NAME="Site Admin"
SEED_ADMIN_EMAIL=admin@ragasoftware.ir
SEED_ADMIN_PASSWORD=change_me
MEDIA_MAX_UPLOAD_KB=4096
RESPONSE_CACHE_ENABLED=false
